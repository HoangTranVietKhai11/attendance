# MondayCheck – Employee Attendance System
# Copy this file to .env and adjust values before running.

# Backend / auth
# Production: generate with `openssl rand -hex 32`; changing it logs all admins out.
JWT_SECRET=change-me-to-a-strong-secret-32-chars
# Used by prisma/seed.ts only when the admin does not exist yet (first deploy).
ADMIN_USERNAME=hr
ADMIN_PASSWORD=change-me-before-first-seed

# Wi-Fi allow-list (comma separated IP/CIDR).
# Public VPS: this must be the COMPANY PUBLIC IP that employee phones egress with
# (all phones on the company Wi-Fi share it). Find it by opening https://api.ipify.org
# on a phone connected to the company Wi-Fi, then add `<ip>/32`.
# Never keep 172.16.0.0/12 in production (it is only for Docker Desktop local testing).
ALLOWED_NETWORKS=127.0.0.1,::1,10.0.10.0/23

# Database (used by docker-compose). If the password contains @ : / ? #, URL-encode it
# in DATABASE_URL (e.g. p@ss -> p%40ss).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-to-a-strong-password
POSTGRES_DB=mondaycheck
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mondaycheck?schema=public

# Address employees open in the browser (QR / check-in links are built from it).
# Public VPS: https://your-domain.com — must be reachable from phones; never "localhost".
# PUBLIC_IP is only a LAN HTTP fallback link; leave empty when using HTTPS.
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1
PUBLIC_IP=

# Wi-Fi employees must join to check in. Shown on the check-in page when their IP is
# outside ALLOWED_NETWORKS (e.g. they are on 4G/5G or another Wi-Fi).
WIFI_NAME=Wi-Fi công ty
WIFI_PASSWORD=
WIFI_INSTRUCTIONS=Tắt 4G/5G, vào Cài đặt > Wi-Fi, chọn đúng tên Wi-Fi bên dưới và nhập mật khẩu, sau đó bấm "Kiểm tra lại".

# Rate limits per client IP: check-in attempts / minute and general API calls / minute.
# On Windows + Docker Desktop every phone shares the docker gateway IP, so raise the
# check-in limit while testing locally (production on Linux sees per-phone IPs).
CHECKIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=120

# Cloudflare Tunnel (khi VPS không có IP public).
# Tạo Named Tunnel + Public Hostname -> http://nginx:80, dán token vào đây rồi:
#   docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Daily attendance session (check-in resets every day because records are per session).
AUTO_SESSION_ENABLED=false
AUTO_SESSION_NAME=Sinh hoạt đầu giờ
AUTO_SESSION_START=08:50
AUTO_SESSION_END=09:00
AUTO_SESSION_TIMEZONE=Asia/Ho_Chi_Minh