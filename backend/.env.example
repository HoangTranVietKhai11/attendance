# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=https://mondaycheck.onrender.com
CORS_ORIGINS=https://mondaycheck.onrender.com,http://localhost:5173,http://localhost,http://127.0.0.1
TRUSTED_PROXY=true

# Database
DATABASE_URL="postgresql://postgres:change-this-password@localhost:5432/mondaycheck?schema=public"

# Auth
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Default admin (seeded on first run)
ADMIN_USERNAME=hr
ADMIN_PASSWORD=Admin@123

# Allowed company public IPs / CIDRs (comma separated). Update when public IP changes.
ALLOWED_NETWORKS=127.0.0.1,::1

# Wi-Fi shown to employees when their IP is outside the allow-list (4G/5G/other Wi-Fi)
WIFI_NAME=Wi-Fi công ty
WIFI_PASSWORD=
WIFI_INSTRUCTIONS=Tắt 4G/5G, kết nối đúng Wi-Fi công ty rồi bấm "Kiểm tra lại".

# Rate limits per client IP per minute (raise during local Docker Desktop testing)
CHECKIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=120